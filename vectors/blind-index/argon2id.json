        "index_key": "2a85bd94c53499a05e326f588ba638079bb51ecd7b58804cb97037a0ff0654ab",
        "normalize": "nfc-casefold-v1",
        "plaintext_preimage_a": "alice@example.com",
        "plaintext_preimage_b": "Alice@Example.COM",
        "truncate_bits": 15
      },
      "expected": {
        "index_a": "b0c0",
        "index_b": "b0c0",
        "must_be_equal": true
      }
