  "cards": [
    {
      "dot": "emerald",
      "title": "The index only narrows",
      "items": [
        "Truncation makes collisions certain (§7.4)",
        "Every candidate is decrypted and re-verified (§7.5)",
        "count() and get() verify too; .candidates() opts out"
      ]
    },
    {
      "dot": "rose",
      "title": "What a query costs",
      "items": [
        "Argon2id: ~10–100 ms per query term (§7.3)",
        "Rows fetched: a small multiple of the true matches (§7.4)",
        "The read path's key rules apply to every candidate"
      ]
    },
    {
      "dot": "orange",
      "title": "What is refused",
      "items": [
        "exclude(), negated Q and XOR over the field (§10.2)",
        "ORDER BY, DISTINCT or aggregates over envelopes",
        "contains, iexact, ranges: no index can answer (§7.10)"
      ]
    }
  ]
