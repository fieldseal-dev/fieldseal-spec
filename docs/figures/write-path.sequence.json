  "cards": [
    {
      "dot": "emerald",
      "title": "Fresh on every write",
      "items": [
        "Fresh msg_seed and nonce on every write, UPDATEs too (§4.4)",
        "Single-use record key, never stored (§5.3)",
        "Context bound in KDF info and AAD (§6.3)"
      ]
    },
    {
      "dot": "rose",
      "title": "Two keys, never crossed",
      "items": [
        "The DEK encrypts; a sibling index key indexes (§5.2)",
        "KMS is reached only by warm(); a cache miss fails closed (§8.1)",
        "Every envelope carries a key commitment (§4.6)"
      ]
    },
    {
      "dot": "orange",
      "title": "What the database sees",
      "items": [
        "Only the envelope and a truncated index (§3.3, §7.11)",
        "The index filters queries, never answers them (§7.5)",
        "Suite 0xFF01 is provisional; nothing is frozen (§4.8)"
      ]
    }
  ]
