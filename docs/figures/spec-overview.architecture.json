  "cards": [
    {
      "dot": "emerald",
      "title": "One format, any language",
      "items": [
        "What core A writes, core B reads with the same key",
        "Both must pass the same pinned vectors (§12)",
        "One frozen suite: no per-field algorithm choice (§4)"
      ]
    },
    {
      "dot": "rose",
      "title": "Adapters hold no crypto",
      "items": [
        "An adapter only routes values to the core (§10)",
        "Where an ORM path would write plaintext, it throws",
        "The value path is synchronous; warm() prefetches keys"
      ]
    },
    {
      "dot": "orange",
      "title": "Search without plaintext",
      "items": [
        "A blind index finds candidate rows by equality (§7)",
        "Candidates are decrypted and re-verified (§7.5)",
        "Low-cardinality columns are refused an index (§7.6)"
      ]
    }
  ]
