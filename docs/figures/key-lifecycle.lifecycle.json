  "cards": [
    {
      "dot": "emerald",
      "title": "Rotation is not re-encryption",
      "items": [
        "Re-wrapping under a new KEK leaves data keys as they were (§5.8)",
        "Only a full sweep reaches Unreferenced; on-read never does",
        "Index keys rotate separately, with an index rebuild (§7.8)"
      ]
    },
    {
      "dot": "rose",
      "title": "What exists today",
      "items": [
        "Versions and the active one: the key directory (core)",
        "rotate(): in core; the sweep tool is not built yet",
        "No destruction API; §8.2 constrains any that is added"
      ]
    },
    {
      "dot": "orange",
      "title": "Why destruction waits",
      "items": [
        "A destroyed key makes its envelopes unreadable (§8.2)",
        "A delay window and a confirmation step are mandatory",
        "Cancel within the window returns to Unreferenced"
      ]
    }
  ]
