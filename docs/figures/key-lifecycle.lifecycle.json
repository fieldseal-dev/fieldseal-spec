        "id": "sweep",
        "label": "Re-encryption",
        "focus": [
          "decrypt",
          "sweep",
          "retired"
        ],
        "note": "Only a full sweep moves every envelope off a version, which is what lets it be destroyed (§5.8)."
      },
      {
        "id": "destroy",
        "label": "Destruction",
        "focus": [
          "retired",
          "scheduled",
          "destroyed",
          "lost"
        ],
        "note": "Destruction is unrecoverable: it needs a delay window and a confirmation step (§8.2)."
      }
    ]
  },
