        "focus": [
          "row",
          "recognize",
          "authorize",
          "e-recognize",
          "e-authorize"
        ],
        "note": "Recognition and the allow-list decide from the header bytes alone, before a key is asked for (§3.4, §4.3)."
      },
      {
        "id": "keys",
        "label": "Keys and commitment",
        "focus": [
          "authorize",
          "keys",
          "commit",
          "e-keys",
          "e-commit"
        ],
        "note": "Every cached, currently valid key is a candidate; the commitment is checked before the AEAD is opened (§4.6)."
      },
      {
        "id": "open",
        "label": "Open and return",
        "focus": [
          "commit",
          "open",
          "value",
          "e-open"
        ],
        "note": "Only a committed key opens the ciphertext; the adapter turns the bytes back into a value (§3.6)."
      }
    ]
  },
