  "cards": [
    {
      "dot": "emerald",
      "title": "Checked before any key",
      "items": [
        "Not an envelope: strict raises, permissive returns it as-is (§10.3)",
        "fmt_ver 0x02 raises in every mode (§3.4)",
        "Allow-list decides authorization, never recognition (§4.3)"
      ]
    },
    {
      "dot": "rose",
      "title": "Commitment before AEAD",
      "items": [
        "Each cached key version is a candidate (§5.6)",
        "Only a key whose commitment matches may open (§4.6)",
        "A wrong context fails here too, like a wrong key (§6.3)"
      ]
    },
    {
      "dot": "orange",
      "title": "Never degrades",
      "items": [
        "Every failure is a distinct §9 error, never a null",
        "No KMS call: a key not in the cache is KEY_UNAVAILABLE",
        "Error messages carry no plaintext or key material (§9)"
      ]
    }
  ]
