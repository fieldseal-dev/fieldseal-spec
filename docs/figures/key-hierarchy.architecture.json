  "cards": [
    {
      "dot": "emerald",
      "title": "Siblings, not derivatives",
      "items": [
        "The index key is never derived from the DEK (§5.2)",
        "Rotating data keys leaves every index valid (§5.8)",
        "Shredding a tenant destroys both keys (§5.2)"
      ]
    },
    {
      "dot": "rose",
      "title": "Where keys live",
      "items": [
        "The KEK stays in the KMS; tenant keys are stored wrapped",
        "Only warm() unwraps them, into a zeroized cache (§5.5)",
        "Record and blind-index keys are derived, never stored"
      ]
    },
    {
      "dot": "orange",
      "title": "One purpose per key",
      "items": [
        "No single global DEK by default (§5.1)",
        "A fresh msg_seed makes every record key single-use",
        "Each index on each column has its own key (§7.2)"
      ]
    }
  ]
