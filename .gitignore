.idea/
.vscode/
*.swp

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/
dist/
# tools/release/build_dists.py output
dist-release/
# the CI npm dry-run's repacked copies (conformance.yml, release-readiness)
ci-repack/

# Java / .NET / Go
target/
# Gradle (core/java)
.gradle/
core/java/**/build/
core/java/build/
# jqwik's per-run database of failing samples (docs/27 §7 property tests)
core/java/**/.jqwik-database
bin/
obj/

# Logs
*.log

# Secrets
.env
.env.*

# AI
.claude/settings.local.json

# Internal scratch docs (not persisted to repo)
internal/
# ...but not the Java core's `internal` packages (docs/27 §3), which the
# pattern above would otherwise match at any depth.
!core/java/*/src/**/internal/

# Conformance reports (docs/14 §4) written in-tree by local harness runs
conformance-*.json
cross-*.json
verdict-*.json

# Vector generator virtualenv (tools/vector-gen)
tools/vector-gen/.venv/
*.egg-info/
__pycache__/
