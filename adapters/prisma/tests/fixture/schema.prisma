// Test fixture schema.
//
// Covers, deliberately: an indexed encrypted column, an unindexed one, every
// non-text logical value type, a tenant-bound column, a bucketed column, a
// plaintext column on a model that also has encrypted ones, both directions of
// a relation so nested writes and `include` nesting are exercised, and a model
// with no declarations at all (Referral) so the walk *through* an undeclared
// model is exercised -- the topology every real schema has.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// @fieldseal(table_uuid: "018f3c2e-0000-7000-8000-0000000000aa")
model Patient {
  id        String  @id @default(uuid())
  /// @fieldseal(encrypted, column_uuid: "018f3c2e-0000-7000-8000-000000000001")
  email     Bytes
  /// @fieldseal(index: "email", index_id: "exact", idf: "hmac-sha512",
  ///            normalize: "nfc-casefold-v1", truncate_bits: 15,
  ///            projected_population: 100000)
  emailBidx Bytes?
  /// @fieldseal(encrypted, column_uuid: "018f3c2e-0000-7000-8000-000000000002")
  note      Bytes
  /// @fieldseal(encrypted, as: "int", column_uuid: "018f3c2e-0000-7000-8000-000000000003")
  age       Bytes
  /// @fieldseal(encrypted, storage: "base64", column_uuid: "018f3c2e-0000-7000-8000-000000000007")
  nickname  String?
  /// The nullable indexed column: `not: null` beside an equality is only a
  /// legal Prisma filter on a nullable column, and this is also the one index
  /// whose source is stored as base64 text rather than raw bytes.
  /// @fieldseal(index: "nickname", index_id: "exact", idf: "hmac-sha512",
  ///            normalize: "nfc-casefold-v1", truncate_bits: 15,
  ///            projected_population: 100000)
  nicknameBidx Bytes?
  /// @fieldseal(encrypted, as: "datetime", column_uuid: "018f3c2e-0000-7000-8000-000000000008")
  born      Bytes?
  /// @fieldseal(encrypted, as: "boolean", column_uuid: "018f3c2e-0000-7000-8000-000000000009")
  active    Bytes?
  /// @fieldseal(encrypted, as: "float", column_uuid: "018f3c2e-0000-7000-8000-00000000000a")
  score     Bytes?
  /// @fieldseal(encrypted, as: "bytes", column_uuid: "018f3c2e-0000-7000-8000-00000000000b")
  blob      Bytes?
  plainName String
  visits    Visit[]
  referrals Referral[]

  @@index([emailBidx])
  @@index([nicknameBidx])
}

// Deliberately NO @fieldseal declarations: this model exists so the tests can
// prove that writes, reads and filters that reach Patient *through* it still
// traverse the pipeline. Dropping it from the field map made it a bypass.
model Referral {
  id        String  @id @default(uuid())
  source    String
  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String
}

/// @fieldseal(table_uuid: "018f3c2e-0000-7000-8000-0000000000bb")
model Visit {
  id         String  @id @default(uuid())
  patient    Patient @relation(fields: [patientId], references: [id])
  patientId  String
  /// @fieldseal(encrypted, column_uuid: "018f3c2e-0000-7000-8000-000000000004")
  reason     Bytes
  /// The indexed encrypted column on the far side of a to-many relation: the
  /// second of the two `where` sites §7.5 re-verification can reach, since an
  /// `include`d relation's rows come back nested in their parents.
  /// @fieldseal(index: "reason", index_id: "exact", idf: "hmac-sha512",
  ///            normalize: "nfc-casefold-v1", truncate_bits: 15,
  ///            projected_population: 100000)
  reasonBidx Bytes?

  @@index([reasonBidx])
}

/// @fieldseal(table_uuid: "018f3c2e-0000-7000-8000-0000000000cc")
model TenantDoc {
  id   String @id @default(uuid())
  /// @fieldseal(encrypted, tenant_bound, column_uuid: "018f3c2e-0000-7000-8000-000000000005")
  body Bytes
}

/// @fieldseal(table_uuid: "018f3c2e-0000-7000-8000-0000000000dd")
model Person {
  id            String @id @default(uuid())
  /// @fieldseal(encrypted, column_uuid: "018f3c2e-0000-7000-8000-000000000006", noun: "name")
  legalName     Bytes
  /// @fieldseal(index: "legalName", index_id: "exact", idf: "hmac-sha512",
  ///            normalize: "nfc-casefold-v1", truncate_bits: 15,
  ///            projected_population: 100000, on_unindexable: "bucket")
  legalNameBidx Bytes?

  @@index([legalNameBidx])
}
