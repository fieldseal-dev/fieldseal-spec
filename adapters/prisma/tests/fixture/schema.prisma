// Test fixture schema.
//
// Covers, deliberately: an indexed encrypted column, an unindexed one, a
// non-text logical value, a tenant-bound column, a bucketed column, a plaintext
// column on a model that also has encrypted ones, and both directions of a
// relation so nested writes and `include` nesting are exercised.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// @fieldseal(table_uuid: "018f3c2e-0000-7000-8000-0000000000aa")
model Patient {
  id        String  @id @default(uuid())
  /// @fieldseal(encrypted, column_uuid: "018f3c2e-0000-7000-8000-000000000001")
  email     Bytes
  /// @fieldseal(index: "email", index_id: "exact", idf: "hmac-sha512",
  ///            normalize: "nfc-casefold-v1", truncate_bits: 15,
  ///            projected_population: 100000)
  emailBidx Bytes?
  /// @fieldseal(encrypted, column_uuid: "018f3c2e-0000-7000-8000-000000000002")
  note      Bytes
  /// @fieldseal(encrypted, as: "int", column_uuid: "018f3c2e-0000-7000-8000-000000000003")
  age       Bytes
  /// @fieldseal(encrypted, storage: "base64", column_uuid: "018f3c2e-0000-7000-8000-000000000007")
  nickname  String?
  plainName String
  visits    Visit[]

  @@index([emailBidx])
}

/// @fieldseal(table_uuid: "018f3c2e-0000-7000-8000-0000000000bb")
model Visit {
  id        String  @id @default(uuid())
  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String
  /// @fieldseal(encrypted, column_uuid: "018f3c2e-0000-7000-8000-000000000004")
  reason    Bytes
}

/// @fieldseal(table_uuid: "018f3c2e-0000-7000-8000-0000000000cc")
model TenantDoc {
  id   String @id @default(uuid())
  /// @fieldseal(encrypted, tenant_bound, column_uuid: "018f3c2e-0000-7000-8000-000000000005")
  body Bytes
}

/// @fieldseal(table_uuid: "018f3c2e-0000-7000-8000-0000000000dd")
model Person {
  id            String @id @default(uuid())
  /// @fieldseal(encrypted, column_uuid: "018f3c2e-0000-7000-8000-000000000006", noun: "name")
  legalName     Bytes
  /// @fieldseal(index: "legalName", index_id: "exact", idf: "hmac-sha512",
  ///            normalize: "nfc-casefold-v1", truncate_bits: 15,
  ///            projected_population: 100000, on_unindexable: "bucket")
  legalNameBidx Bytes?

  @@index([legalNameBidx])
}
